# Server-only settings. Copy to .env locally; never upload .env as a public file.
PORT=8787
HOST=0.0.0.0
PUBLIC_ORIGIN=https://YOUR-PORTFOLIO-DOMAIN
EMAIL_PROVIDER=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=jensebastian2001@gmail.com
EMAIL_FROM=jensebastian2001@gmail.com
# Use a provider SMTP credential / Gmail app password, never an ordinary account password.
EMAIL_PASSWORD=
# Set only to the known number of trusted reverse-proxy hops (e.g. 1 on a single managed proxy).
TRUST_PROXY_HOPS=
